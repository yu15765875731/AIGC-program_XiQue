# 复制为 .env 后填写。不填也能跑（走「抽取式基线」，用于测检索质量）

# ---- LLM（OpenAI 兼容接口）----
# DeepSeek:  https://api.deepseek.com/v1   LLM_CHAT_MODEL=deepseek-chat
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_CHAT_MODEL=qwen-plus
# 智谱GLM:   https://open.bigmodel.cn/api/paas/v4   LLM_CHAT_MODEL=glm-4-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat

# ---- Embedding（留空 = 只做关键词检索，即 V0 基线）----
# DeepSeek 暂无 embedding；可用通义 text-embedding-v3 等
LLM_EMBED_MODEL=

# ---- 检索与切片参数（改这里做 A/B 实验）----
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100
WEIGHT_VECTOR=0.6
WEIGHT_KEYWORD=0.4

# 分词器：bigram（汉字二元组，零依赖）/ jieba / auto
RAG_TOKENIZER=bigram

# 抽取式回答拼接前 N 个片段
ANSWER_K=1

# 拒答阈值：由 calibrate.py 标定，不要凭感觉写
MIN_SCORE=8.76
# 置信度换算参考分：原始检索分达到该值记为置信度 1.0（按语料分布标定）
CONF_REF=24
HUMAN_THRESHOLD=0.6
